{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Work Diary",
  "version": "1.0.0",
  "identifier": "com.workdiary.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Щоденник робіт / Work Diary",
        "width": 480,
        "height": 820,
        "minWidth": 360,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Minimalist work diary with Obsidian export",
    "longDescription": "Minimalist diary of completed work: date, client or project, description, keywords, links and attachments. Writes notes into an Obsidian vault.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
